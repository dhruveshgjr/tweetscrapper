{
  "manifest_version": 3,
  "name": "X Tweet Scraper Panel",
  "version": "1.0.0",
  "description": "Browse and search scraped tweets from the local API server.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}